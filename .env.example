# App URL
NEXT_PUBLIC_SITE_URL=https://northorbis.com

# SMTP email notifications. Recommended production channel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=
NOTIFICATION_EMAIL_TO=

# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=NorthOrbis AIMA <you@gmail.com>
# NOTIFICATION_EMAIL_TO=growth@northorbis.com

# Open-source push notifications via ntfy.
# Install the ntfy mobile app and subscribe to a private topic name.
NTFY_TOPIC=
# NTFY_TOPIC_URL=https://ntfy.sh/northorbis-leads-change-this-secret-topic
# NTFY_TOKEN=
# NTFY_USERNAME=
# NTFY_PASSWORD=

# Optional open-source WhatsApp bridge via self-hosted WAHA.
# WAHA is unofficial WhatsApp Web automation. Use a dedicated WhatsApp number.
WAHA_API_URL=
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_TO=
# WAHA_CHAT_ID=15550101234@c.us

# Optional generic webhook for n8n, Make, Zapier, or custom automation.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Local-only escape hatch. Do not set this to true in production.
ALLOW_NO_LEAD_NOTIFICATIONS=false
