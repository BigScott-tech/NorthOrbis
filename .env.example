# SMTP settings for outgoing email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_SECURE=false

# Notification recipient (default set to NorthOrbis email)
NOTIFICATION_EMAIL_TO=northorbisteam@gmail.com

# Twilio WhatsApp settings
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+1234567890
TWILIO_WHATSAPP_TO=whatsapp:+2349078501664
